{
  "name": "fusion-module-core",
  "version": "0.0.0",
  "description": "Monorepo for fusion-module core: protocol contracts, framework-agnostic runtime, and Vue bindings.",
  "private": true,
  "type": "module",
  "author": "刘晨宇",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "pnpm -r run build",
    "build:watch": "pnpm -r --parallel run build:watch",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "format": "oxfmt .",
    "clean": "rimraf packages/*/build packages/*/dist packages/*/.turbo packages/*/node_modules/.cache",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "docs:dev": "vitepress dev doc",
    "docs:build": "vitepress build doc",
    "docs:preview": "vitepress preview doc",
    "docs-usage:dev": "vitepress dev doc-usage",
    "docs-usage:build": "vitepress build doc-usage",
    "docs-usage:preview": "vitepress preview doc-usage"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.67.0",
    "eslint-plugin-vue": "^10.9.1",
    "jiti": "^2.7.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1",
    "vitepress": "2.0.0-alpha.17",
    "vue": "^3.5.35",
    "vue-tsc": "^3.3.2"
  }
}