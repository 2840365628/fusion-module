{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "eslint.config.ts",
    "*.config.ts",
    "*.config.mts",
    "packages/*/*.config.ts",
    "packages/*/*.config.mts",
    "doc/.vitepress/**/*.ts",
    "doc-usage/.vitepress/**/*.ts"
  ],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true
  }
}
